========================================================================================
This codes will first check if a table with certain name exist in the database, if it
does, then it will drop the table and then it will create a new table with the same name

Please use this code with caution as it will rewrite the existing tables and create new
empty ones
========================================================================================


-- Use the database DataWarehouse
USE DataWarehouse;
GO


-- Check if table exist, drop if exist
IF OBJECT_ID('bronze.crm_cust_info', 'U') IS NOT NULL
	DROP TABLE bronze.crm_cust_info;

-- Create new table
CREATE TABLE bronze.crm_cust_info(
	cst_id INT,
	cst_key NVARCHAR(50),
	cst_firstname NVARCHAR(50),
	cst_lastname NVARCHAR(50),
	cst_marital_status NVARCHAR(50),
	cst_gndr NVARCHAR(50),
	cst_create_date DATE
);

